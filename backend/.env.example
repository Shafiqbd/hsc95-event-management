NODE_ENV=development
PORT=4000
# Origin of the Next.js app (CORS). With the default Next.js /api proxy the
# browser talks same-origin and CORS is not used.
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_SCHEMA=hsc95
DB_SSL=false
DB_POOL_MAX=10

# At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace_with_a_strong_random_secret_of_32_plus_chars
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME=hsc95_session
# Defaults: Secure=true when NODE_ENV=production, SameSite=lax.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax

# Map hsc95."T_UserType" rows to the three application roles.
#   SELECT * FROM hsc95."T_UserType";   -> 1 Admin, 2 Register, 3 Report Viewer
# *_NAMES are matched at login (case-insensitive); *_ID is used when creating users.
ADMIN_USER_TYPE_NAMES=Admin
ADMIN_USER_TYPE_ID=1
REGISTER_USER_TYPE_NAMES=Register
REGISTER_USER_TYPE_ID=2
VIEWER_USER_TYPE_NAMES=Report Viewer
VIEWER_USER_TYPE_ID=3

# Member photos (kept outside the source tree, never served statically)
UPLOAD_DIR=./storage
PHOTO_MAX_BYTES=2097152

# Authoritative fee rules (amount stored in T_EventForm.AmountPaid)
EVENT_REGISTRATION_FEE=1500
EVENT_DRIVER_FEE=500
